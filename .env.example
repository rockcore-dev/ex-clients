# Bybit testnet API credentials.
#
# Only used by integration tests in tests/integration/**. Private tests
# are skipped when these are absent or empty, so it's safe to leave them
# unset for purely public smoke testing.
#
# Get keys at https://testnet.bybit.com (Login -> API Management).

BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
